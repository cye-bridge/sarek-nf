/*
 * Nextflow configuration
 */

plugins {
    id 'nf-schema@2.6.1'
    id 'nf-amazon@~3.4.0'
}

/*
 * AWS Configuration for native S3 access
 */
aws {
    accessKey = System.getenv('NEXTFLOW_AWS_ACCESS_KEY_ID') ?: System.getenv('AWS_ACCESS_KEY_ID')
    secretKey = System.getenv('NEXTFLOW_AWS_SECRET_ACCESS_KEY') ?: System.getenv('AWS_SECRET_ACCESS_KEY')
    region    = System.getenv('AWS_DEFAULT_REGION') ?: 'us-east-1'

    client {
        maxConnections     = 20
        connectionTimeout  = 300000
        uploadStorageClass = 'STANDARD'
        storageEncryption  = 'AES256'
        uploadMaxThreads   = 10
        uploadChunkSize    = '10MB'
        maxErrorRetry      = 3
    }
}

params {
    input  = 'samplesheet.csv'
    outdir = '.'
}

profiles {
    test {
        process.executor = 'local'
        process.cpus = 1
        process.memory = '1 GB'
        process.time = '5m'
    }
}