{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/minimal_sarek_schema.json",
  "title": "Minimal nf-core/sarek test schema",
  "description": "Minimal schema for pipeline smoke testing only",
  "type": "object",

  "properties": {
    "input": {
      "type": "string",
      "description": "Path to samplesheet CSV",
      "default": "samplesheet.csv"
    },
    "outdir": {
      "type": "string",
      "description": "Output directory",
      "default": "results"
    }
  },

  "required": [
    "input",
    "outdir"
  ],

  "additionalProperties": true
}